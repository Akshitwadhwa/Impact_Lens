# Copy this file to .env and use the values from your Cloudinary Console.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: requires the Google Auto Tagging add-on in your Cloudinary account.
ENABLE_AUTO_TAGGING=false

# Optional: lets ChatGPT read the intake brief and label photos. Keep this server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
